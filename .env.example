# All integrations below are OFF by default (see src/config/features.ts).
# You only need to fill these in once you flip the matching flag to `true`.

GROQ_API_KEY=
# Optional backup key. The chat API tries the next key when Groq returns
# a rate-limit/capacity error.
GROQ_API_KEY_2=
APP_URL=https://www.yourdomain.dev
# Get your free key at resend.com (3000 emails/month free)
RESEND_API_KEY=
